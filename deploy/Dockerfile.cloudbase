# AI Novel Forge - 腾讯云 CloudBase 云托管 单容器镜像
#
# 构建上下文：仓库根目录（在云托管控制台把「构建目录」设为 /，
#   「Dockerfile 路径」设为 deploy/Dockerfile.cloudbase）。
#
# 设计：单容器内同时运行
#   - nginx      : 监听 80，托管前端静态文件 + 同源反代 /api -> 127.0.0.1:8000
#   - uvicorn    : 后端，监听 127.0.0.1:8000
# 数据持久化：DATABASE_URL 与 CHROMA_PERSIST_DIR 都指向 /data（在控制台挂载 CFS）。
# 不额外购买云数据库，SQLite + Chroma 全部落在 CFS 持久卷。

# ---------- 阶段 1：构建前端静态文件 ----------
FROM node:20-alpine AS fe-build
WORKDIR /app
COPY frontend/ ./
RUN npm install && npm run build

# ---------- 阶段 2：运行镜像 ----------
FROM python:3.11-slim
WORKDIR /app

# 系统依赖：nginx（托管前端）+ supervisord（单容器多进程管理）
RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -f /etc/nginx/sites-enabled/default \
    && rm -rf /var/lib/apt/lists/*

# 后端 Python 依赖
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# 后端代码
COPY backend/ ./

# 前端构建产物
COPY --from=fe-build /app/dist /usr/share/nginx/html

# nginx：前端同源反代后端（单容器，后端在 127.0.0.1:8000）
COPY deploy/nginx.cloudbase.conf /etc/nginx/conf.d/default.conf

# supervisord：同时拉起 nginx 与后端
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
