# ============================================================
# AI-Novel-Forge 环境变量模板
# 用法：复制本文件为 .env 并填入你自己的值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入任何仓库（含公开仓库）。
# ============================================================

# ===== 智谱 LLM（必填）=====
# 在 https://open.bigmodel.cn 注册后获取 API Key
ZHIPU_API_KEY=你的智谱APIKey
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_EMBED_MODEL=embedding-3
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=65536

# ===== 数据库 =====
# 本地 / Docker Compose（默认 PostgreSQL）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/novelforge
# 单容器 / 云托管（零依赖 SQLite，推荐新手与云部署）：
DATABASE_URL=sqlite+aiosqlite:///./novelforge.db

# ===== 向量库（Chroma 持久化目录）=====
CHROMA_PERSIST_DIR=./.chroma

# ===== 服务监听 =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== 账号鉴权（B 方案：独立账号 + 数据隔离）=====
# SECRET_KEY 用于签发 / 校验 JWT（HS256）。生产必填，且务必换成随机长字符串：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 未配置时回退开发默认值（仅本地，切勿用于生产）。
SECRET_KEY=

# 开放注册：任何人可访问站点自助注册账号（默认开启，无需邀请码）。
# 如需关闭注册、改为仅已有账号可登录，把下方设为 false。
ALLOW_OPEN_REGISTER=true

# ===== CORS（仅前后端分离 / 云托管需要）=====
# 同源部署（nginx 反代 /api）留空即可；分离部署可设为前端域名或 *。
# CORS_ORIGINS=*
